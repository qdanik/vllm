FROM ghcr.io/gonka-ai/vllm:v0.9.1

# ==============================================================================
# Core vLLM Settings
# ==============================================================================
ENV VLLM_USE_V1=0

# ==============================================================================
# Torch Compile (10-25% speedup on forward pass)
# Level 3 = PIECEWISE compilation - compiles model in optimized pieces
# First inference will be slower due to compilation (~5-15 min), subsequent faster
# Set to 0 to disable if causing issues
# ==============================================================================
ENV VLLM_TORCH_COMPILE_LEVEL=3

# ==============================================================================
# Attention Backend: FA3 (FlashInfer tested - no improvement)
# ==============================================================================
ENV VLLM_FLASH_ATTN_VERSION=3
# ENV VLLM_ATTENTION_BACKEND=FLASHINFER  # Tested: 1095/min (same as FA3)

# ==============================================================================
# DeepGEMM: Not available in base image (requires separate installation)
# ==============================================================================
# ENV VLLM_USE_DEEP_GEMM=1  # Disabled - package not installed

# ==============================================================================
# NCCL Optimizations
# ==============================================================================
ENV NCCL_CUMEM_ENABLE=0
ENV NCCL_NVLS_ENABLE=1

# ==============================================================================
# PoC Settings
# ==============================================================================
# Enable profiling to measure forward pass vs post-processing times
ENV POC_PROFILE=0
ENV POC_PROFILE_DETAILED=0
# Disable fused Haar (causes overhead from precompute)
ENV POC_USE_FUSED_HAAR=1
ENV USE_TRITON_KERNELS=1

# Copy local code to temp location
COPY ./vllm /tmp/vllm-src

# Upgrade NCCL to 2.29.3 for better H100 performance
# Falls back to 2.26.2 if 2.29.3 has compatibility issues
RUN python3 -m pip uninstall nvidia-nccl-cu12 -y && \
    python3 -m pip install nvidia-nccl-cu12==2.29.2

# Merge only .py files into existing vllm package (preserves .so files)
RUN cd /tmp/vllm-src \
    && find . -name "*.py" | tar -cf - -T - | tar -xf - -C /usr/local/lib/python3.12/dist-packages/vllm/ \
    && rm -rf /tmp/vllm-src