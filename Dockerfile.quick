FROM vllm/vllm-openai:v0.17.0

# Default to FP16 MoE (TRITON) for PoC (Proof of Compute)
ENV VLLM_USE_DEEP_GEMM=0
ENV VLLM_MOE_USE_DEEP_GEMM=0

ENV VLLM_USE_FLASHINFER_MOE_FP8=0
ENV VLLM_FLASHINFER_MOE_BACKEND=throughput
ENV VLLM_USE_FLASHINFER_MOE_FP16=1  

# FlashAttention v3 enabled by default
# vllm/v1/attention/backends/fa_utils.py:58

# PoC (Proof of Compute) config for H100HBM
# Default configuration for 8x NVIDIA H100 80GB HBM3 | 79GB
ENV POC_MAX_NUM_BATCHED_TOKENS=32768
ENV POC_BATCH_SIZE_DEFAULT=32
ENV POC_MAX_NUM_SEQS=256

# TODO: Do not enable for production
ENV POC_LOG_ARTIFACTS_JSON=0

# Copy local code to temp location
COPY ./vllm /tmp/vllm-src

# PoC (Proof of Compute) dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install scipy

# Remove CUDA compat stub (it overrides host libcuda and causes cuInit=803)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get remove -y cuda-compat-12-9 || true \
 && rm -f /etc/ld.so.conf.d/*cuda*compat* || true \
 && ldconfig

# Merge .py files and fused MoE tuned configs into existing vllm package
# (preserves .so files)
RUN cd /tmp/vllm-src \
    && find . \( -name "*.py" -o -path "./model_executor/layers/fused_moe/configs/*.json" \) \
    | tar -cf - -T - | tar -xf - -C /usr/local/lib/python3.12/dist-packages/vllm/ \
    && rm -rf /tmp/vllm-src
